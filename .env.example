# =============================================================================
# BusTerminal 环境变量参考（全部为占位符，请勿把真实值提交进版本库）
#
# 本文件是**完整参考**，列出后端实际读取的环境变量。
#   - 只想快速把服务跑起来：复制仓库根目录的 `.env.install.example`
#     （它只需要改端口和数据库口令）
#   - 想精细调整运行行为：复制本文件为 `.env`，按注释逐项修改
#
# 约定：
#   * 所有地址、路径、口令均为**占位符**，请替换为你自己的值。
#   * 未列出的变量后端不会读取（测试用的 *_MOCK_* 系列除外）。
#   * 含「设置页」说明的变量也可在 Web 控制台「设置」里修改，且**以界面值为准**。
#   * 密码 / 令牌 / Key 留空 = 未配置；在设置页留空 = 保持原值不变（不会清空）。
# =============================================================================

# -----------------------------------------------------------------------------
# 一、基础运行
# -----------------------------------------------------------------------------

# 宿主机映射端口（容器内固定 8000，这里改的是对外端口）
BUS_TERMINAL_PORT=8012
# 监听地址。只想本机访问填 127.0.0.1；局域网共享保持 0.0.0.0
BUS_TERMINAL_BIND=0.0.0.0

# 数据目录：封面缓存 + 运行配置 + SQLite 回退库。
# ⚠️ 封面缓存是重要性能资产（删除后要重新抓取），建议放机械盘并纳入备份。
DATA_DIR=./data

LOG_LEVEL=INFO
TZ=Asia/Shanghai

# -----------------------------------------------------------------------------
# 二、数据库
# -----------------------------------------------------------------------------

# 主库连接串。留空则回退到 DATA_DIR/movies.db（SQLite，单机试用足够）。
# PostgreSQL 示例（角色名与库名必须一致）：
#   DATABASE_URL=postgresql://busterminal:<你的口令>@bus_postgres:5432/busterminal
DATABASE_URL=

# ⚠️ DATABASE_URL 只在进程启动时读取，运行期无法切换；改了必须重建容器。

# 自带 PostgreSQL 容器时使用（docker-compose.install.yml 的 with-db profile）。
# 口令同时被 compose 以 POSTGRES_PASSWORD 注入容器。
BUS_PG_USER=busterminal
BUS_PG_DB=busterminal
BUS_PG_PASSWORD=<在这里填强口令，例如 openssl rand -base64 24>
# ⚠️ 数据库目录放机械盘。放 SSD/NVMe 缓存盘会因 4k-fsync 极慢而拖垮容器。
BUS_PG_DATA_DIR=./pgdata

# 首次部署必须为 true，否则自动建表被跳过、接口报表不存在；日常运行保持 false。
BUS_TERMINAL_ALLOW_SCHEMA_MIGRATION=true

# 加密存储敏感配置项（如 qB 口令、API Key）的密钥。
# 生成一个长随机串填入，例如 openssl rand -base64 32。
# 更换该密钥会导致已加密的旧配置无法解密。
# BUS_TERMINAL_CONFIG_SECRET=

# -----------------------------------------------------------------------------
# 三、安全与鉴权
# -----------------------------------------------------------------------------

# true = 首次打开走 /setup 创建管理员账号。**强烈建议保持 true**。
# false = 无鉴权，任何人都能读改删你的数据，只适用于一次性隔离环境。
REQUIRE_AUTH=true

# 跨域来源（逗号分隔）。前后端同源部署时留空即可。
# 例：CORS_ORIGINS=https://bus.example.com
CORS_ORIGINS=

# 维护类安全闸门。默认全 false，只在备份后、明确的维护窗口内临时打开。
BUS_TERMINAL_ALLOW_DESTRUCTIVE_MAINTENANCE=false
BUS_TERMINAL_ALLOW_CACHE_MAINTENANCE=false

# 启动行为：是否预加载、是否禁用后台任务（本地调试建议禁用，避免副作用）
BUS_TERMINAL_PRELOAD_ON_STARTUP=true
BUS_TERMINAL_DISABLE_STARTUP_TASKS=false

# 调试开关：暴露端点清单 / 原始 API 响应。生产必须保持 false。
BUS_TERMINAL_SHOW_ENDPOINTS=false
BUS_TERMINAL_SHOW_RAW_API_RESPONSE=false
BUS_TERMINAL_WRITE_RAW_API_RESPONSE=false
BUS_TERMINAL_SHOW_UNSAFE_RAW_API_RESPONSE=false

# -----------------------------------------------------------------------------
# 四、网络与代理
# -----------------------------------------------------------------------------

# 出网代理（抓取境外内容站点用）。不需要就留空。
# 例：SYSTEM_PROXY=http://192.168.1.1:7890
SYSTEM_PROXY=

# 内网服务（qBittorrent / Jellyfin / amane / 本地 Ollama）是否也跟随上面这个代理。
# ⚠️ 必须保持 false，否则内网请求会被代理劫持而失败。
BUS_TERMINAL_INTERNAL_PROXY_ENABLED=false

# 额外的内容源镜像域名（可选，逗号/空格/分号分隔）。留空则只用内置源。
# EXTRA_DOMAINS=

# 少数图床证书异常时允许跳过图片请求的 TLS 校验（默认关闭，请优先修证书）。
SCRAPER_ALLOW_INSECURE_IMAGE_FETCH=false

# -----------------------------------------------------------------------------
# 五、缓存与性能
# -----------------------------------------------------------------------------

# 磁盘图片缓存上限（GB）。设置页里的值优先于这里。
CACHE_SIZE_LIMIT_GB=10
BUS_TERMINAL_INFORMATION_FLOW_PRELOAD_PAGES=10
# 影片详情缓存 TTL（秒）
BUS_TERMINAL_MOVIE_DETAIL_CACHE_TTL=21600
# 图片失败标记 TTL（秒），避免反复重试坏图
BUS_TERMINAL_IMAGE_FAILURE_TTL=1800

# 后台任务间隔（秒）：智能过滤/下载后处理保持较短周期；做种维护低频即可。
GROOM_TASK_INTERVAL=60
SEEDING_MAINTENANCE_INTERVAL=14400

# -----------------------------------------------------------------------------
# 六、外部服务：qBittorrent（可选，也可在引导页 / 设置页填）
# -----------------------------------------------------------------------------

# 主机名或地址，**不要带协议前缀**；端口单独填。
# 例：QB_HOST=192.168.1.100   QB_PORT=8080
QB_HOST=
QB_PORT=
QB_USERNAME=
QB_PASSWORD=
QB_VERIFY_SSL=true
# 允许的保存路径白名单（留空 = 不限制，多个用逗号分隔）
# BUS_TERMINAL_QB_ALLOWED_SAVE_ROOTS=

# 下载完成后的投递目录（容器内路径）。必须与 qB / amane 看到的是同一个真实目录。
DELIVERY_FOLDER=/downloads/staging

# -----------------------------------------------------------------------------
# 七、外部服务：Jellyfin（可选，也可在引导页 / 设置页填）
# -----------------------------------------------------------------------------

JELLYFIN_HOST=
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=
# Jellyfin 媒体库根路径（用于路径映射与展示）
# JELLYFIN_LIBRARY_PATH=

# -----------------------------------------------------------------------------
# 八、外部服务：amane（可选；不接则只能浏览与下载，无法自动刮削整理入库）
# -----------------------------------------------------------------------------

# 例：AMANE_BASE_URL=http://192.168.1.100:8000
# 留空 = 未配置，相关功能会明确报「未配置」，不会静默连到任何主机。
AMANE_BASE_URL=
# 在 amane 设置页生成后填入
AMANE_TOKEN=
AMANE_TIMEOUT_SECONDS=10
AMANE_TASK_TIMEOUT_SECONDS=300
# 入库自愈巡检（会自动写 amane）：默认关闭，确认无误后再开。
AMANE_HEAL_ENABLED=false

# -----------------------------------------------------------------------------
# 九、翻译（可选）
# -----------------------------------------------------------------------------

# 可选值：google_free / baidu_dev / ollama_local
TRANSLATION_PROVIDER=google_free

BAIDU_APP_ID=
BAIDU_SECRET=

# 本地 Ollama（内网自建大模型，不产生外部请求）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=300
OLLAMA_BATCH_SIZE=12

# -----------------------------------------------------------------------------
# 十、媒体文件根目录白名单（可选，防止整理逻辑越界写文件）
# -----------------------------------------------------------------------------

# 多个目录用逗号分隔，例如：BUS_TERMINAL_MANAGED_MEDIA_ROOTS=/media/adult,/downloads
# BUS_TERMINAL_MANAGED_MEDIA_ROOTS=
BUS_TERMINAL_LEGACY_ORGANIZER=false

# -----------------------------------------------------------------------------
# 十一、内容发现 / 自动下载（可选）
# -----------------------------------------------------------------------------

# Jable 热榜自动下载：默认关闭。开启前请确认磁盘空间与下载权限。
JABLE_HOT_AUTO_DOWNLOAD=false
