# BusTerminal 快速部署配置
# 复制为 .env 后按需修改：  cp .env.install.example .env
# 然后：docker compose -f docker-compose.install.yml up -d

# ============ 必改 ============
# 数据库密码。只在用 --profile with-db 时才需要，但建议先填好。
# 生成强密码：openssl rand -base64 24
BUS_PG_PASSWORD=changeme_please_generate_a_strong_one

# ============ 常用可调 ============
# 宿主机访问端口。装完打开 http://<NAS地址>:<这个端口>
BUS_TERMINAL_PORT=8012
# 监听地址。只想本机访问就填 127.0.0.1；局域网共享保持 0.0.0.0
BUS_TERMINAL_BIND=0.0.0.0

# 镜像。默认用 GHCR 上的官方预构建版，无需本地构建。
# 想换成自建镜像或固定某个版本时才取消下面这行的注释并修改。
# BUS_TERMINAL_IMAGE=ghcr.io/seldoms/busterminal:latest

# 数据目录（封面缓存 + 配置 + SQLite 回退库）。**重要，勿删**
# 用机械盘/HDD 挂载点，不要放系统盘
BUS_DATA_DIR=./data
# 下载投递目录。必须与 qBittorrent 挂载的是同一个真实目录
BUS_DOWNLOADS_DIR=./downloads

# ============ 数据库 ============
# 留空 = 用 /app/data/movies.db（SQLite），单机试用足够。
# 要用 Postgres：加 --profile with-db，然后填下面这段（密码与上面保持一致）：
# DATABASE_URL=postgresql://busterminal:BUS_PG_PASSWORD@bus_postgres:5432/busterminal
DATABASE_URL=
BUS_PG_USER=busterminal
BUS_PG_DB=busterminal
# ⚠️ 数据库放机械盘。放 SSD/NVMe 缓存盘会让容器卡死（4k-fsync 极慢）
BUS_PG_DATA_DIR=./pgdata

# ============ 安全 ============
# true = 首次打开走 /setup 建管理员账号。强烈建议保持 true。
# 只有在完全隔离的一次性试用环境里才设 false（= 无鉴权，任何人都能删数据）
REQUIRE_AUTH=true
# ★ 全新部署必须 true。false 会跳过自动建表，接口会报表不存在
BUS_TERMINAL_ALLOW_SCHEMA_MIGRATION=true

# ============ 网络 ============
# 出网代理。NAS 需要代理才能访问境外源站时填，否则留空
SYSTEM_PROXY=
# 内网服务（amane/Jellyfin/qB）是否跟随代理。生产保持 false
BUS_TERMINAL_INTERNAL_PROXY_ENABLED=false
CORS_ORIGINS=

# ============ 可选：qBittorrent ============
# 也可以留空，装完后在 /setup 引导页里填（推荐，密码不回显更安全）
QB_HOST=
QB_PORT=
QB_USERNAME=
QB_PASSWORD=

# ============ 可选：amane（媒体整理） ============
# 不接 amane 时系统只能下载和展示，无法自动刮削整理入库
AMANE_BASE_URL=
AMANE_TOKEN=

# ============ 可选：翻译 ============
# google_free / ollama_local / baidu_dev
TRANSLATION_PROVIDER=google_free
OLLAMA_BASE_URL=
OLLAMA_MODEL=

TZ=Asia/Shanghai
LOG_LEVEL=INFO