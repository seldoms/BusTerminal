# =============================================================================
# BusTerminal 全栈部署配置
# 用法：cp .env.fullstack.example .env   然后按下面注释改
# =============================================================================

# -----------------------------------------------------------------------------
# ★ 最重要的一项：这套栈里，哪些服务由**本机新建**
# -----------------------------------------------------------------------------
# 只列需要新装的。已经装过的、或跑在别的机器上的，不要写在这里 ——
# 改成在下面「下游服务接入地址」里指向它的真实地址即可。
#
#   可选值（逗号分隔，不要空格）：
#       db        自带 PostgreSQL（不写则 BusTerminal 回退 SQLite）
#       qb        qBittorrent 下载器
#       amane     刮削 / 整理 / 自动入库
#       jellyfin  媒体库与播放
#
#   全栈一把梭：  COMPOSE_PROFILES=db,qb,amane,jellyfin
#   只装应用：    留空
#
#   ⚠️ 下面这行默认是**全开**（照抄即五个容器全新建）。只要其中几个服务时，
#      把不要的从这行里删掉 —— 已经在跑的服务留着会撞端口、撞容器名。
COMPOSE_PROFILES=db,qb,amane,jellyfin

# -----------------------------------------------------------------------------
# 访问端口（被占用就换一个；下面这些是宿主机端口）
# -----------------------------------------------------------------------------
# BusTerminal 控制台
BUS_TERMINAL_PORT=8012
# 只允许本机访问就填 127.0.0.1；局域网共享保持 0.0.0.0
BUS_TERMINAL_BIND=0.0.0.0
# qBittorrent WebUI
QB_WEBUI_PORT=8086
# qBittorrent BT 监听端口（需要在路由器上放行才能当主动节点）
QB_TORRENT_PORT=6881
# amane Web 界面
AMANE_PORT=8013
# Jellyfin
JELLYFIN_PORT=8096

# -----------------------------------------------------------------------------
# 存储路径 —— 全部相对 .env 所在目录，也可以写绝对路径
# -----------------------------------------------------------------------------
# ★ 媒体总根：下载区 + 整理后的媒体库都在它下面。
#   必须放在**容量足够的机械盘**上，不要放系统盘。
#   它会被挂进 qBittorrent / amane / Jellyfin 三个容器，是整条链路的对齐基准。
MEDIA_ROOT=./media

# BusTerminal 自己的数据：封面缓存 + 运行配置 + SQLite 回退库。**勿删**
BUS_DATA_DIR=./data
# PostgreSQL 数据目录（放机械盘，别放 SSD/NVMe 缓存盘）
BUS_PG_DATA_DIR=./pgdata
# 各服务自己的配置目录
QB_CONFIG_DIR=./qbittorrent/config
AMANE_DATA_DIR=./amane/data
JELLYFIN_CONFIG_DIR=./jellyfin/config
JELLYFIN_CACHE_DIR=./jellyfin/cache

# 文件属主（Linux 上用 `id -u` / `id -g` 查；群晖/NAS 常见是 1000:1000）
PUID=1000
PGID=1000

# -----------------------------------------------------------------------------
# 数据库
# -----------------------------------------------------------------------------
BUS_PG_USER=busterminal
BUS_PG_DB=busterminal
# 生成强口令：openssl rand -base64 24
BUS_PG_PASSWORD=changeme_please_generate_a_strong_one
# 连接串三选一：
#   ① 用上面自带的 PostgreSQL（COMPOSE_PROFILES 里含 db）→ 保持下面这行，
#      并把口令同步改成与 BUS_PG_PASSWORD 一致
#   ② 只用 SQLite（COMPOSE_PROFILES 里没有 db）→ 整行留空
#   ③ 接外部已有的 PostgreSQL → 换成你自己的连接串
DATABASE_URL=postgresql://busterminal:changeme_please_generate_a_strong_one@bus_postgres:5432/busterminal

# -----------------------------------------------------------------------------
# 下游服务接入地址 —— 「已装 / 在别的机器上」的服务改这里
# -----------------------------------------------------------------------------
# 由本栈新建的保持默认（容器名即可，容器之间用服务名互访）。
# 已有的服务改成它的真实地址，例如：
#   QB_HOST=192.168.1.50          JELLYFIN_HOST=http://192.168.1.50:8096
#   AMANE_BASE_URL=http://192.168.1.50:8000
QB_HOST=qbittorrent
QB_PORT=8086
QB_USERNAME=admin
QB_PASSWORD=
JELLYFIN_HOST=http://jellyfin:8096
JELLYFIN_API_KEY=
AMANE_BASE_URL=http://amane:8000
AMANE_TOKEN=

# -----------------------------------------------------------------------------
# 投递目录
# -----------------------------------------------------------------------------
# 下载完成后，BusTerminal 让 qBittorrent 把文件移动到这里。
# ★ 必须是 **qB 视角**的路径，且必须落在 amane 的媒体库根（/media）里面 ——
#   这样 amane 才能发现新文件并入库。默认落在库根下的 _incoming 目录。
DELIVERY_FOLDER=/media/_incoming

# -----------------------------------------------------------------------------
# 安全
# -----------------------------------------------------------------------------
# 首次部署保持 true，用 /setup 建管理员账号
REQUIRE_AUTH=true
# ★ 全新部署必须 true，false 会跳过自动建表、接口报表不存在
BUS_TERMINAL_ALLOW_SCHEMA_MIGRATION=true

# -----------------------------------------------------------------------------
# 网络
# -----------------------------------------------------------------------------
# 出网代理（抓境外源站需要时填，例如 http://192.168.1.1:7890）
SYSTEM_PROXY=
# 内网服务是否跟随上面的代理。**保持 false**，否则 amane/Jellyfin 会被劫持
BUS_TERMINAL_INTERNAL_PROXY_ENABLED=false
# 前后端同源部署时留空即可
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# 其它
# -----------------------------------------------------------------------------
TZ=Asia/Shanghai
LOG_LEVEL=INFO
# google_free / ollama_local / baidu_dev
TRANSLATION_PROVIDER=google_free
OLLAMA_BASE_URL=
OLLAMA_MODEL=
