# Download defaults
DEFAULT_RESOLUTION=1080P
DEFAULT_SAVE_PATH=/downloads

# Security
# Built-in login/auth is not implemented yet. Deploy only on a trusted LAN or
# behind an authenticated reverse proxy, firewall, or VPN.

# Data storage
# In Docker this is usually /app/data. For local development, ./data is fine.
DATA_DIR=./data
# Disk image cache capacity in GB. The web settings value overrides this default.
CACHE_SIZE_LIMIT_GB=10
# Proactively cache the first N pages of home/subtitle/HD/discovery feeds.
BUS_TERMINAL_INFORMATION_FLOW_PRELOAD_PAGES=10
# Structured movie detail cache lifetime in seconds (default: 6 hours).
BUS_TERMINAL_MOVIE_DETAIL_CACHE_TTL=21600
# Retry failed image sources after this many seconds (default: 30 minutes).
BUS_TERMINAL_IMAGE_FAILURE_TTL=1800

# Optional external services. Prefer configuring these in the web settings page.
JELLYFIN_HOST=
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=
# Optional: if set, /api/webhooks/jellyfin requires this value in
# X-BusTerminal-Webhook-Token or ?token=...
BUS_TERMINAL_JELLYFIN_WEBHOOK_TOKEN=
QB_HOST=
QB_PORT=8080
QB_USERNAME=admin
QB_PASSWORD=
